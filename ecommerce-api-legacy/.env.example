# Exporte no ambiente antes de `npm start`. Nenhum valor real deve ser commitado.
PORT=3000
DB_PATH=:memory:
PAYMENT_GATEWAY_KEY=
# Obrigatório para GET /api/admin/financial-report e DELETE /api/users/:id (header X-Admin-Token); vazio = rotas desabilitadas (403)
ADMIN_TOKEN=
# Senha do usuário de seed de desenvolvimento (leonan@fullcycle.com.br)
SEED_USER_PASSWORD=
